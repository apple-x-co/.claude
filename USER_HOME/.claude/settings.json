{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "enabledPlugins": {
        "frontend-design@claude-plugins-official": false,
        "security-guidance@claude-plugins-official": true
    },
    "env": {
        "CLAUDE_CODE_NO_FLICKER": "1"
    },
    "extraKnownMarketplaces": {
    },
    "permissions": {
        "deny": [
            "Bash(sudo:*)",
            "Bash(rm -rf:*)",
            "Read(.env*)",
            "Read(id_rsa)",
            "Read(id_ed25519)",
            "Read(**/*.key)",
            "Read(**/.ssh/**)",
            "Write(.env*)",
            "Write(**/secrets/**)",
            "Write(**/.ssh/**)",
            "Bash(npm uninstall:*)",
            "Bash(npm remove:*)",
            "Bash(psql:*)",
            "Bash(mysql:*)",
            "Bash(mongod:*)",
            "NotebookEdit",
            "Write(./node_modules/**)",
            "Write(./vendor/**)",
            "Write(./target/**)",
            "Read(./.git/**)"
        ],
        "ask": [
            "Bash(rm:*)",
            "Bash(curl:*)",
            "Bash(git merge:*)",
            "Bash(git stash:*)",
            "Bash(git push:*)",
            "Bash(git pull:*)",
            "Bash(git reset:*)",
            "Bash(git rebase:*)",
            "Bash(git tag:*)",
            "Bash(npm publish:*)"
        ]
    },
    "language": "Japanese",
    "model": "opusplan",
    "effortLevel": "high",
    "plansDirectory": "./",
    "statusLine": {
        "type": "command",
        "command": "/bin/bash ~/.claude/statusline-command.sh"
    }
}
